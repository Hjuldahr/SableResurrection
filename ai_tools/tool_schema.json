    {
        "type": "function",
        "function": {
            "name": "upsert_note",
            "description": "Create or replace a persistent memory note under a topic.",
            "parameters": {
                "type": "object",
                "properties": {
                    "topic": {
                        "type": "string",
                        "description": "Topic under which the note should be stored."
                    },
                    "note": {
                        "type": "string",
                        "description": "Complete memory note to store."
                    }
                },
                "required": [
                    "topic",
                    "note"
                ]
            }
        }
    },
    {
        "type": "function",
        "function": {
            "name": "search_topics",
            "description": "Search persistent memory for topics semantically related to a query.",
            "parameters": {
                "type": "object",
                "properties": {
                    "query": {
                        "type": "string",
                        "description": "Description of the memory being sought."
                    },
                    "limit": {
                        "type": "integer",
                        "description": "Maximum number of matching topics.",
                        "minimum": 1,
                        "maximum": 50
                    }
                },
                "required": [
                    "query"
                ]
            }
        }
    },
    {
        "type": "function",
        "function": {
            "name": "select_note",
            "description": "Retrieve the complete persistent memory note stored under an exact topic.",
            "parameters": {
                "type": "object",
                "properties": {
                    "topic": {
                        "type": "string",
                        "description": "Exact topic whose note should be retrieved."
                    }
                },
                "required": [
                    "topic"
                ]
            }
        }
    },
    {
        "type": "function",
        "function": {
            "name": "delete_note",
            "description": "Delete the persistent memory note stored under an exact topic.",
            "parameters": {
                "type": "object",
                "properties": {
                    "topic": {
                        "type": "string",
                        "description": "Exact topic whose note should be deleted."
                    }
                },
                "required": [
                    "topic"
                ]
            }
        }
    }
