                        ],
                        "description": "Type of search to perform."
                    }
                },
                "required": [
                    "query"
                ]
            }
        }
    },
    {
        "type": "function",
        "function": {
            "name": "summarize_page",
            "description": "Read a webpage and summarize the information relevant to a specific query.",
            "parameters": {
                "type": "object",
                "properties": {
                    "query": {
                        "type": "string",
                        "description": "Question the webpage should be used to answer."
                    },
                    "url": {
                        "type": "string",
                        "description": "URL of the webpage to read."
                    }
                },
                "required": [
                    "query",
                    "url"
                ]
            }
        }
    },
    {
        "type": "function",
        "function": {
            "name": "summarize_files",
            "description": "Read and summarize one or more local files.",
            "parameters": {
                "type": "object",
                "properties": {
                    "filenames": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "Paths or filenames of the files to summarize."
                    }
                },
                "required": [
                    "filenames"
                ]
            }
        }
    },
    {
        "type": "function",
        "function": {
            "name": "read_file",
            "description": "Read text from a local file.",
            "parameters": {
                "type": "object",
                "properties": {
                    "filename": {
                        "type": "string",
                        "description": "Path or filename of the file to read."
                    },
                    "offset": {
                        "type": "integer",
                        "description": "Character offset at which to begin reading."
                    },
                    "limit": {
                        "type": "integer",
                        "description": "Maximum number of characters to read. Use -1 for no limit."
                    }
                },
                "required": [
                    "filename"
                ]
            }
        }
    },
    {
        "type": "function",
        "function": {
            "name": "write_file",
            "description": "Write text to a local file, either replacing or appending to its contents.",
            "parameters": {
                "type": "object",
                "properties": {
                    "filename": {
                        "type": "string",
                        "description": "Path or filename of the file to write."
                    },
                    "file_content": {
                        "type": "string",
                        "description": "Text to write."
                    },
                    "append": {
                        "type": "boolean",
                        "description": "Whether to append to the file instead of replacing its contents."
                    }
                },
                "required": [
                    "filename"
                ]
            }
        }
    },
    {
        "type": "function",
        "function": {
            "name": "delete_files",
